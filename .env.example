# Routy SaaS endpoint (no trailing slash)
ROUTY_BASE_URL=https://route.routy.io

# Shared secret provisioned in the Routy dashboard
ROUTY_API_KEY=

# Comma-separated list of hostnames this edge serves
DOMAINS=mail.example.com,promo.example.com

# Local logging mode: all | failed | none
CLICK_LOG_MODE=failed

# How long a cached template stays fresh (seconds)
CACHE_TTL_SECONDS=3600

# Time before falling back to cache (milliseconds)
FALLBACK_TIMEOUT_MS=800

# Replay loop
REPLAY_BATCH_SIZE=500
REPLAY_INTERVAL_MS=30000

# Postgres
DATABASE_URL=postgres://routy:routy@postgres:5432/routy_edge

# Server
PORT=8080
LOG_LEVEL=info
