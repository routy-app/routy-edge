{
  "name": "routy-edge",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Self-hosted edge proxy for Routy redirect links.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "nanoid": "^5.0.7",
    "pg": "^8.12.0",
    "pino": "^9.3.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "pino-pretty": "^11.2.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
